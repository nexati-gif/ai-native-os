# Direnv configuration for AI-Native OS Orchestrator
# Run `direnv allow` after adding this file

# Use nix flake dev shell
use flake .

# Or manually source the dev shell
# source_up
# export RUSTUP_TOOLCHAIN=stable
# export CARGO_TARGET_DIR=./target

# Environment variables for development
export RUST_LOG=orchestrator=info,orchestrator_observe=debug,orchestrator_plan=debug
export RUST_BACKTRACE=1

# Cargo settings
export CARGO_INCREMENTAL=1
export CARGO_NET_RETRY=3

# Model paths (adjust for your system)
export ORCHESTRATOR_MODEL_PATH=/var/lib/orchestrator/models/qwen2.5-coder-32b-4bit.gguf
export ORCHESTRATOR_LORA_PATH=/var/lib/orchestrator/lora
export ORCHESTRATOR_RAG_PATH=/var/lib/orchestrator/rag
export ORCHESTRATOR_INFERENCE_BACKEND=candle
export ORCHESTRATOR_QUANTIZATION=Q4_K_M
export ORCHESTRATOR_CONTEXT_LENGTH=32768
export ORCHESTRATOR_GPU_LAYERS=-1
export ORCHESTRATOR_THREADS=0
export ORCHESTRATOR_IDLE_TIMEOUT=30

# Federation
export ORCHESTRATOR_FEDERATION_ENABLED=true
export ORCHESTRATOR_AUTOMERGE_PATH=/var/lib/orchestrator/federation.automerge
export ORCHESTRATOR_GIT_REMOTE=git@github.com:your-org/ai-native-os-federation.git
export ORCHESTRATOR_GIT_BRANCH=main
export ORCHESTRATOR_SYNC_INTERVAL=300
export ORCHESTRATOR_DEVICE_NAME=$(hostname)

# Sandbox
export ORCHESTRATOR_SANDBOX_BACKEND=firecracker
export ORCHESTRATOR_FIRECRACKER_VCPUS=2
export ORCHESTRATOR_FIRECRACKER_MEMORY_MIB=512
export ORCHESTRATOR_WARM_POOL_SIZE=0

# UI
export ORCHESTRATOR_UI_MODE=both
export ORCHESTRATOR_WEB_PORT=8080
export ORCHESTRATOR_WEB_BIND=127.0.0.1
export ORCHESTRATOR_AUTH_TOKEN=

# Policy
export ORCHESTRATOR_POLICY_ENGINE=opa
export ORCHESTRATOR_POLICIES_DIR=/etc/orchestrator/policies
export ORCHESTRATOR_DEFAULT_DENY=true

# Layout for Python virtual env (if needed)
# layout python3