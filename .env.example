# AI-Native OS Orchestrator Environment Variables
# Copy to .env and customize (not committed to git)

# Device identification
DEVICE_ID=my-laptop

# Model configuration
MODEL_PATH=/var/lib/orchestrator/models/qwen2.5-coder-32b-4bit.gguf
LORA_PATH=/var/lib/orchestrator/lora
RAG_PATH=/var/lib/orchestrator/rag

# Inference backend: candle, llama.cpp, vllm
INFERENCE_BACKEND=candle
QUANTIZATION=Q4_K_M
CONTEXT_LENGTH=32768
GPU_LAYERS=-1
THREADS=0

# Federation
TAILSCALE_AUTH_KEY=tskey-xxxxxxxxxxxxxxxxx
FEDERATION_GIT_REMOTE=git@github.com:your-org/ai-native-os-federation.git
FEDERATION_GIT_BRANCH=main
AUTOMERGE_PATH=/var/lib/orchestrator/federation.automerge
SYNC_INTERVAL_SECS=300

# UI
WEB_PORT=8080
WEB_BIND=127.0.0.1
UI_AUTH_TOKEN=your-secure-token-here

# Sandbox
SANDBOX_BACKEND=firecracker
FIRECRACKER_VCPUS=2
FIRECRACKER_MEMORY_MIB=512
WARM_POOL_SIZE=0

# Logging
RUST_LOG=orchestrator=info,orchestrator_observe=debug,orchestrator_plan=debug
RUST_BACKTRACE=1

# Development
DEV_MODE=false