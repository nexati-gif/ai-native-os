# EditorConfig for AI-Native OS Orchestrator
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{rs,toml}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 0

[*.{sh,bash,zsh}]
indent_size = 2
end_of_line = lf

[*.nix]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

[Dockerfile]
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.{py}]
indent_size = 4